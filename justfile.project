# Seeded by vigOS devkit — yours to edit; upgrades never overwrite this file.
# Bugs / missing tools: https://github.com/vig-os/devkit/issues

# ===============================================================================
# PROJECT RECIPES - Team-shared customizations
# This file is git-tracked and preserved during devcontainer upgrades.
# Add team-shared recipes here that everyone on the project should use.
# ===============================================================================
# ===============================================================================
# PROJECT VARIABLES
# ===============================================================================

project := "stepv"
# ===============================================================================
# INFO
# ===============================================================================

# Show project information
[group('info')]
info:
    @echo "Project: {{ project }}"

# -------------------------------------------------------------------------------
# CODE QUALITY
# -------------------------------------------------------------------------------

# The uv-backed recipes below are guarded on pyproject.toml so they stay safe in
# a non-Python repo — but they REPORT the skip instead of no-oping in silence: a
# repo that lost its pyproject.toml used to run nothing, print nothing and exit 0
# (#1478). Whether the skip is legitimate is asserted once in CI, against the
# languages this repo declares in .vig-os (DEVKIT_LANGUAGES).

# Run all linters
#
# stepv: the scaffold's recipes are Python-only, so in this Rust repo CI's
# "Tests" and lint lanes ran NOTHING and reported green (vig-os/devkit#1811).
# The Rust branch below is the real check: rustfmt, clippy with
# warnings as errors on both feature sets, and the whole test suite against a
# freshly built kernel. A repo with neither project file still says so.
[group('quality')]
lint:
    @if [ -f Cargo.toml ]; then just _rust-lint; fi
    @if [ -f pyproject.toml ]; then uv run ruff check .; elif [ ! -f Cargo.toml ]; then echo "just lint: no pyproject.toml or Cargo.toml — skipping"; fi

[private]
_rust-lint:
    cargo fmt --check
    cargo clippy --workspace --all-targets -- -D warnings
    cargo clippy --all-targets --no-default-features -- -D warnings

# Format code
[group('quality')]
format:
    @if [ -f pyproject.toml ]; then uv run ruff format .; else echo "just format: no pyproject.toml — skipping"; fi

# Run pre-commit hooks on all files
[group('quality')]
precommit:
    prek run --all-files

# -------------------------------------------------------------------------------
# TESTING
# -------------------------------------------------------------------------------

# Run tests with pytest. Exit 5 ("no tests collected") is a no-op ONLY while the
# repo has no tests/ directory — a fresh scaffold. Once a test directory exists,
# zero collected is a signal, not a no-op, so it propagates (#1281 narrowed by
# #1478).
[group('test')]
test *args:
    @if [ -f Cargo.toml ]; then just _rust-test {{ args }}; fi
    @if [ ! -f pyproject.toml ]; then [ -f Cargo.toml ] || echo "just test: no pyproject.toml or Cargo.toml — skipping"; elif uv run pytest {{ args }}; then :; else rc=$?; if [ "$rc" -eq 5 ] && [ ! -d tests ]; then echo "just test: no tests collected and no tests/ directory — skipping"; else exit "$rc"; fi; fi

# The CLI tests run the REAL kernel and fail without it (tests/cli.rs), so it
# is built first. Lint runs here too: CI's lint lane only runs `just precommit`,
# whose hooks have no rustfmt or clippy.
[private]
_rust-test *args: kernel _rust-lint
    cargo test --workspace {{ args }}

# Run tests with coverage (same exit-5 rule as `test` above)
[group('test')]
test-cov *args:
    @if [ ! -f pyproject.toml ]; then echo "just test-cov: no pyproject.toml — skipping"; elif uv run pytest --cov --cov-report=term-missing {{ args }}; then :; else rc=$?; if [ "$rc" -eq 5 ] && [ ! -d tests ]; then echo "just test-cov: no tests collected and no tests/ directory — skipping"; else exit "$rc"; fi; fi

# -------------------------------------------------------------------------------
# DEPENDENCIES
# -------------------------------------------------------------------------------

# Sync dependencies (all groups; extras are opt-in, e.g. `just sync --all-extras`)
[group('deps')]
sync *args="--all-groups":
    @if [ -f pyproject.toml ]; then uv sync {{ args }}; else echo "just sync: no pyproject.toml — skipping"; fi

# Update all dependencies
[group('deps')]
update:
    uv lock --upgrade
    @just sync

# -------------------------------------------------------------------------------
# BUILD
# -------------------------------------------------------------------------------

# Clean build artifacts
[group('build')]
clean-artifacts:
    rm -rf .pytest_cache .ruff_cache .coverage htmlcov dist build *.egg-info
    find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

# ===============================================================================
# PROJECT-SPECIFIC RECIPES
# ===============================================================================
# Uncomment and customize for your project:
# # Run the application
# [group('app')]
# run *args:
#     uv run python -m {{project}} {{args}}
#
# # Boot the local dev services declared in flake.nix (mkProjectServices,
# # #795): daemonless process-compose stack, state in ./data (gitignore it).
# [group('services')]
# services *args:
#     nix run .#services -- {{args}}
#
# # Prepare release branch (manual workflow dispatch helper)
# [group('release')]
# prepare-release version:
#     gh workflow run prepare-release.yml --ref dev -f "version={{ version }}"
#
# # Finalize and publish release (manual workflow dispatch helper)
# [group('release')]
# finalize-release version:
#     gh workflow run release.yml --ref release/{{ version }} -f "version={{ version }}" -f "release-kind=final" -f "dry-run=false"
#
# # Publish candidate release (manual workflow dispatch helper)
# [group('release')]
# publish-candidate version:
#     gh workflow run release.yml --ref release/{{ version }} -f "version={{ version }}" -f "release-kind=candidate" -f "dry-run=false"

# ===============================================================================
# STEPV RECIPES
# ===============================================================================

# Fetch the robustness corpus into tests/fixtures/ (gitignored) and rewrite
# tests/fixtures/corpus.sha256 (committed). The corpus is the gate: a kernel is
# chosen on its pass rate here, not on reputation. Pass source names to fetch
# only those. See plan.md §5 and tests/fixtures/manifest.toml.
[group('harness')]
fixtures *sources: kernel
    python3 scripts/fetch-fixtures.py {{ sources }}

# Build the Plan B native-OCCT kernel (kernel/) into target/kernel/stepv-occt.
[group('harness')]
kernel:
    cmake -S kernel -B target/kernel -DCMAKE_BUILD_TYPE=Release
    cmake --build target/kernel -j

# Regenerate the small committed test corpus (tests/data/) the CLI tests use.
[group('harness')]
test-data: kernel
    mkdir -p tests/data
    ./target/kernel/fixture-gen tests/data

# S3: run the real CLI over the corpus with default limits; fails on any hang,
# bad JSON, out-of-contract exit code, metadata-less exit 3, or kernel crash.
[group('harness')]
cli-sweep *args: kernel
    cargo build --release
    python3 scripts/cli-sweep.py {{ args }}

# S5: build target/macos/stepv.app (Quick Look preview + thumbnail extensions).
# stepv-capi is built ON ITS OWN: building it with --workspace would unify in
# the CLI's default `viewer` feature and drag the window library into the
# extensions. Sign with STEPV_SIGN_IDENTITY (default ad-hoc).
[group('macos')]
macos-app: kernel
    cargo build --release --bin stepv
    cargo build --release -p stepv-capi
    scripts/build-macos-app.sh

# Install target/macos/stepv.app into /Applications and enable its Quick Look
# extensions (what launching the app and System Settings would do).
[group('macos')]
macos-install: macos-app
    rm -rf /Applications/stepv.app
    cp -R target/macos/stepv.app /Applications/
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f /Applications/stepv.app
    for x in /Applications/stepv.app/Contents/PlugIns/*.appex; do pluginkit -a "$x"; done
    pluginkit -e use -i ch.exoma.stepv.thumbnail
    pluginkit -e use -i ch.exoma.stepv.preview
    qlmanage -r >/dev/null 2>&1 || true

# Headless macOS checks (Swift reader vs Rust, offscreen preview render, and
# with --quicklook the real Quick Look round trip against /Applications).
[group('macos')]
macos-test *args: macos-app
    scripts/test-macos.sh {{ args }}

# DMG; signed with STEPV_SIGN_IDENTITY and notarised when Apple credentials exist.
[group('macos')]
macos-package: macos-app
    scripts/package-macos.sh

# Run the kernel robustness harness over tests/fixtures/ and print the
# pass-rate / timing table that plan.md §5 asks you to record.
# ALWAYS --release: debug wasmtime is ~100x slower and looks like a broken kernel.
[group('harness')]
harness *args: kernel
    cargo run --release --example harness -- {{ args }}
