<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key><string>ch.exoma.stepv</string>
	<key>CFBundleName</key><string>stepv</string>
	<key>CFBundleDisplayName</key><string>stepv</string>
	<key>CFBundleExecutable</key><string>stepv-host</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>@VERSION@</string>
	<key>CFBundleVersion</key><string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key><string>14.0</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>LSApplicationCategoryType</key><string>public.app-category.graphics-design</string>
	<!-- macOS has no system type for STEP, IGES or BREP. Imported, not
	     exported: if a CAD app on the machine owns these extensions, its
	     declaration wins and nothing here fights it. Deliberately NOT
	     public.3d-content: Apple's SceneKit thumbnail extension claims that,
	     wins the dispatch for some of these files and then fails on them. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>ch.exoma.stepv.step</string>
			<key>UTTypeDescription</key><string>STEP CAD model</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>step</string><string>stp</string><string>p21</string></array>
				<key>public.mime-type</key><array><string>model/step</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>ch.exoma.stepv.iges</string>
			<key>UTTypeDescription</key><string>IGES CAD model</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>igs</string><string>iges</string></array>
				<key>public.mime-type</key><array><string>model/iges</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>ch.exoma.stepv.occt-brep</string>
			<key>UTTypeDescription</key><string>Open CASCADE BREP model</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>brep</string></array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
